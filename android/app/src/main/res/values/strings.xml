<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared strings. Each screen keeps its own in strings_<screen>.xml, so they can be worked on separately.
    The English text is the iOS app's, word for word. Only app_name is translated (values-ar), as on iOS.
-->
<resources>
    <string name="app_name">Muda</string>
    <!-- مداقش is the game's name: shown as-is in every language. -->
    <string name="wordmark" translatable="false">مداقش</string>

    <string name="ok">OK</string>
    <string name="cancel">Cancel</string>
    <string name="error_title">Something went wrong</string>
    <string name="error_removed">The host removed you from the room.</string>
    <string name="error_bad_response">Unexpected response from the server</string>

    <string name="sound_turn_off">Turn sound off</string>
    <string name="sound_turn_on">Turn sound on</string>
    <string name="how_to_play">How to play</string>

    <string name="report_offensive">Offensive name</string>
    <string name="report_impersonation">Pretending to be someone</string>
    <string name="report_other">Something else</string>
</resources>
