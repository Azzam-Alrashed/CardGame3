rules_version = '2';

// All writes go through Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {
    // Players can read rooms they are in (includes the public view of the round).
    match /rooms/{code} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerIds;
      allow write: if false;

      // Each player can read only their own cards.
      match /hands/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    // Everything else, including rooms/{code}/private, is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
